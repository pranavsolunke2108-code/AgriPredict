# =====================================================================
# AgriPredict Environment Configuration (.env.example)
# Copy this file to .env and fill in your MySQL credentials
# =====================================================================

# Database Connection Settings (Least-Privilege App Account:
# SELECT, INSERT, UPDATE, DELETE, EXECUTE, CREATE TEMPORARY TABLES)
DB_HOST=localhost
DB_PORT=3306
DB_USER=agripredict_app
DB_PASSWORD=your_agripredict_app_password
DB_NAME=agripredict
DB_POOL_NAME=agripredict_pool
DB_POOL_SIZE=5

# Migration / DDL Account (Full DDL rights for migrations & test setup)
DB_MIGRATE_USER=agripredict_migrate
DB_MIGRATE_PASSWORD=your_agripredict_migrate_password

# JWT Session Configuration
JWT_SECRET=super_secret_jwt_key_for_agripredict_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
